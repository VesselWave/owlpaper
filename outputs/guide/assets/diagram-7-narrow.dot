digraph G {
graph [rankdir=TB, bgcolor="transparent", nodesep=.32, ranksep=.42, pad=.06, fontname="Helvetica", newrank=true, splines=spline];
node [fontname="Helvetica", fontsize=14, margin=".16,.09", penwidth=1.2, fillcolor="#ffffff"];
edge [fontname="Helvetica", fontsize=12, arrowsize=.65, penwidth=1.2];
s08 [shape=box, style="rounded,dashed", class="note", label=<<b><font face="Menlo" point-size="13">08_run_experiment.py</font><br/><font face="Menlo" point-size="13">--profile …</font></b><br/><font point-size="12.5">runs every</font><br/><font point-size="12.5">step below,</font><br/><font point-size="12.5">one fresh</font><br/><font point-size="12.5">process each</font>>];
s00 [shape=box, style="rounded", class="op", label=<<b><font face="Menlo" point-size="13">00_hardware.py</font></b>>];
hw [shape=note, style="filled", class="data", label=<<b><font face="Menlo" point-size="13">hardware.json</font></b>>];
c [shape=note, style="filled", class="data", label=<<b><font face="Menlo" point-size="13">configs/</font><br/><font face="Menlo" point-size="13">cherry.json</font><br/><font face="Menlo" point-size="13">cherry_olmo.json</font></b>>];
s01 [shape=box, style="rounded", class="op", label=<<b><font face="Menlo" point-size="13">01_download.py</font></b>>];
cfg [shape=note, style="filled", class="data", label=<<b><font face="Menlo" point-size="13">config.json</font><br/><font face="Menlo" point-size="13">model.json</font></b>>];
s02 [shape=box, style="rounded", class="op", label=<<b><font face="Menlo" point-size="13">02_prompts.py</font></b>>];
pq [shape=note, style="filled", class="data", label=<<b><font face="Menlo" point-size="13">prompts.jsonl</font><br/><font face="Menlo" point-size="13">questions.jsonl</font></b>>];
s03ab [shape=box, style="rounded", class="op", label=<<b><font face="Menlo" point-size="13">03_evaluate.py</font></b><br/><font point-size="12.5">--name base</font><br/><font point-size="12.5">--name teacher</font><br/><font point-size="12.5">--teacher</font>>];
s04 [shape=box, style="rounded", class="op", label=<<b><font face="Menlo" point-size="13">04_generate.py</font></b>>];
eab [shape=note, style="filled", class="data", label=<<b><font face="Menlo" point-size="13">eval/base.jsonl</font><br/><font face="Menlo" point-size="13">eval/teacher.jsonl</font></b>>];
raw [shape=note, style="filled", class="data", label=<<b><font face="Menlo" point-size="13">raw.jsonl</font></b><br/><font point-size="12.5">both arms,</font><br/><font point-size="12.5">paired seeds</font>>];
s05 [shape=box, style="rounded", class="op", label=<<b><font face="Menlo" point-size="13">05_filter.py</font><br/><font face="Menlo" point-size="13">--keep N</font></b>>];
fd [shape=note, style="filled", class="data", label=<<b><font face="Menlo" point-size="13">filter_decisions</font><br/><font face="Menlo" point-size="13">.jsonl</font><br/><font face="Menlo" point-size="13">filter_summary</font><br/><font face="Menlo" point-size="13">.json</font></b>>];
td [shape=note, style="filled", class="data", label=<<b><font face="Menlo" point-size="13">treatment.jsonl</font><br/><font face="Menlo" point-size="13">control.jsonl</font></b>>];
s06 [shape=box, style="rounded", class="op", label=<<b><font face="Menlo" point-size="13">06_train.py</font></b><br/><font point-size="12.5">--arm A --seed</font><br/><font point-size="12.5">K</font>>];
ad [shape=note, style="filled", class="data", label=<<b><font face="Menlo" point-size="13">adapters/A-sK/</font></b><br/><font point-size="12.5">token_audit,</font><br/><font point-size="12.5">loss, epoch-*,</font><br/><font point-size="12.5">finished</font>>];
s03c [shape=box, style="rounded", class="op", label=<<b><font face="Menlo" point-size="13">03_evaluate.py</font></b><br/><font point-size="12.5">--name A-sK</font><br/><font point-size="12.5">--adapter …</font>>];
es [shape=note, style="filled", class="data", label=<<b><font face="Menlo" point-size="13">eval/A-sK.jsonl</font></b>>];
s07 [shape=box, style="rounded", class="op", label=<<b><font face="Menlo" point-size="13">07_report.py</font></b>>];
rep [shape=note, style="filled", class="data", label=<<b><font face="Menlo" point-size="13">summary.csv / .json</font><br/><font face="Menlo" point-size="13">comparison.png</font></b>>];
s08 -> s00 [style=dashed];
s00 -> hw [];
c -> s01 [];
s01 -> cfg [];
cfg -> s02 [];
s02 -> pq [];
pq -> s04 [];
s04 -> raw [];
raw -> s05 [];
s05 -> fd [];
s05 -> td [];
td -> s06 [];
s06 -> ad [];
ad -> s03c [];
s03c -> es [];
es -> s07 [];
s07 -> rep [];
pq -> s03ab [];
s03ab -> eab [];
eab -> s07 [];
{rank=same; s00; c;} {rank=same; hw; s01;} hw -> cfg [style=invis];
{rank=same; s03ab; s04;} {rank=same; eab; raw;} s05 -> td [style=invis, minlen=2];
}